# Sworn Indexer: every variable it reads. Copy to .env (docker compose reads it) or set
# them as service variables on Railway. Never commit a filled-in copy.

# --- Required -----------------------------------------------------------------------
# Ethereum mainnet ARCHIVE RPC (eth_getLogs over old ranges, eth_call at old blocks).
# Several endpoints may be given comma-separated: Ponder load-balances and fails over.
# Public endpoints for a trial: see .imd/reads/skills/public-rpcs/REFERENCE.md (or chainlist.org).
# The mainnet backfill in README.md ran on https://gateway.tenderly.co/public/mainnet plus
# one.valve.city's public demo endpoint. A public endpoint rate-limits a backfill; a keyed
# endpoint is what production wants. publicnode refuses archive getLogs without a token.
PONDER_RPC_URL_1=

# --- Optional -----------------------------------------------------------------------
# Websocket for realtime tailing (cheaper than polling). Leave empty to poll over HTTP.
PONDER_WS_URL_1=
# Postgres. Empty: PGlite under PGLITE_DIRECTORY (the named volume in docker compose).
# On Railway: a reference to the Postgres service's DATABASE_URL.
DATABASE_URL=
# Railway also injects DATABASE_PRIVATE_URL on some templates; it wins over DATABASE_URL.
# DATABASE_PRIVATE_URL=
# Where PGlite keeps its data when no DATABASE_URL is set (the image sets /data/pglite).
PGLITE_DIRECTORY=/data/pglite
# HTTP port (Railway injects its own).
PORT=42069
# Origins allowed by CORS, comma-separated; "*" allows any.
CORS_ORIGINS=https://sworn.vibingco.de,https://sworn.sites.imd.fun

# Postgres schema for this deployment. Default: RAILWAY_DEPLOYMENT_ID on Railway, else
# the build id baked into the image. Set only to pin a schema by hand.
DATABASE_SCHEMA=
# Fixed schema whose views point at the live deployment (SELECT * FROM sworn_indexer.card).
# "off" disables views.
PONDER_VIEWS_SCHEMA=sworn_indexer

# Largest eth_getLogs block span requested (Ponder shrinks it further on "range too large").
PONDER_GETLOGS_BLOCK_RANGE=500
# How often to poll for new blocks when no websocket is set (ms).
PONDER_POLLING_INTERVAL_MS=4000
# Node heap cap and young-generation size (the image default; see README "Memory").
NODE_OPTIONS="--max-old-space-size=192 --max-semi-space-size=4"
# Ponder indexing cache size in bytes (default: a fifth of the heap). The image sets 32 MB.
PONDER_CACHE_BYTES=33554432

# --- Contracts (defaults are the mainnet deployments) ------------------------------
SWORN_REGISTRY_ADDRESS=0x0da2679000ea5380d1361cc3cca7d4e8c881f766
SWORN_REGISTRY_START_BLOCK=26242885
IMD_TOKEN_ADDRESS=0xd34a99bc0f67ae1bbd63c660e6d0b0dd03e263b7
IMD_PAYEE_ADDRESS=0x4e0fa57bde726079356537e2f34d671e9f41adbc
IMD_TOKEN_START_BLOCK=26038414
CURATOR_ADDRESS=0xcb0b0531e86a9ac36fa865ca8e3dbccf047fda91
CURATOR_START_BLOCK=25769870
CURATOR_END_BLOCK=25789721
IDMD_SEAT_ADDRESS=0x0000eC93127BAA929E58E97dd0095A2BFb38ec1D
IDMD_SEAT_START_BLOCK=25090085
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# --- Docker host only ---------------------------------------------------------------
# Host port published by docker compose, and the external network Caddy is on.
HOST_PORT=42069
CADDY_NETWORK=caddy
# Only with `docker compose --profile postgres`: the bundled Postgres password, and then
# DATABASE_URL=postgres://postgres:<that password>@postgres:5432/postgres
POSTGRES_PASSWORD=

# docker compose memory limit for the indexer container (see README "Memory").
MEM_LIMIT=768m
